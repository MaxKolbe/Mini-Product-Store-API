<h2 style="color: #333; margin: 0 0 8px 0;">Hi, <%= name %>!</h2>
<p style="color: #666; margin: 0 0 24px 0;">Thank you for your purchase. Here's your order receipt.</p>

<table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
  <tr style="background: #f9f9f9;">
    <td style="padding: 8px 12px; text-align: left; font-size: 13px; font-weight: bold; color: #444; border-bottom: 2px solid #e0e0e0;">Order ID</td>
    <td style="padding: 8px 12px; text-align: right; font-size: 13px; color: #444; border-bottom: 2px solid #e0e0e0;"><%= orderId.slice(0, 8).toUpperCase() %></td>
  </tr>
  <tr>
    <td style="padding: 8px 12px; text-align: left; font-size: 13px; font-weight: bold; color: #444; border-bottom: 1px solid #eee;">Date</td>
    <td style="padding: 8px 12px; text-align: right; font-size: 13px; color: #444; border-bottom: 1px solid #eee;"><%= new Date(createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %></td>
  </tr>
</table>

<table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
  <thead>
    <tr style="background: #1b1b1e;">
      <th style="padding: 10px 12px; text-align: left; font-size: 13px; color: #fff; border-radius: 4px 0 0 0;">Item</th>
      <th style="padding: 10px 12px; text-align: center; font-size: 13px; color: #fff;">Qty</th>
      <th style="padding: 10px 12px; text-align: right; font-size: 13px; color: #fff; border-radius: 0 4px 0 0;">Amount</th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach(function(item) { %>
    <tr>
      <td style="padding: 10px 12px; text-align: left; font-size: 13px; color: #333; border-bottom: 1px solid #eee;"><%= item.name %></td>
      <td style="padding: 10px 12px; text-align: center; font-size: 13px; color: #333; border-bottom: 1px solid #eee;"><%= item.quantity %></td>
      <td style="padding: 10px 12px; text-align: right; font-size: 13px; color: #333; border-bottom: 1px solid #eee;">$<%= (item.amount / 100).toFixed(2) %></td>
    </tr>
    <% }); %>
  </tbody>
</table>

<table style="width: 100%; border-collapse: collapse;">
  <tr>
    <td style="padding: 12px; text-align: right; font-size: 16px; font-weight: bold; color: #1b1b1e;">Total: $<%= (amount / 100).toFixed(2) %></td>
  </tr>
</table>

<hr style="border: none; border-top: 1px solid #eee; margin: 24px 0 16px 0;" />
<p style="color: #999; font-size: 12px; margin: 0;">If you have any questions about your order, simply reply to this email. Thanks for shopping with us!</p>
